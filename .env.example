# ============================================================
# 无限流规则怪谈 (Fenli) — 环境变量配置模板
# 复制此文件为 .env，填入实际值后使用
# ============================================================

# ── 数据库配置（必填）──
# MySQL 密码，无默认值，必须设置
MYSQL_PASS=your_mysql_password_here

# MySQL 主机地址（可选，默认 127.0.0.1）
# MYSQL_HOST=127.0.0.1

# MySQL 端口（可选，默认 3306）
# MYSQL_PORT=3306

# MySQL 用户名（可选，默认 root）
# MYSQL_USER=root

# MySQL 数据库名（可选，默认 fenli）
# MYSQL_DB=fenli

# ── JWT 配置（强烈建议设置，否则每次重启密钥变化，所有token失效）──
# 生成方法: python -c "import secrets; print(secrets.token_hex(32))"
# JWT_SECRET=your_jwt_secret_here

# ── 兑换码密钥（可选，默认 fenli_xchg_secret）──
# 生成方法: python -c "import secrets; print(secrets.token_hex(16))"
# XCHG_SECRET=your_xchg_secret_here

# ── 管理员账号（可选，仅此变量存在时才会自动创建admin用户）──
# ADMIN_PASSWORD=your_admin_password_here

# ── 服务监听配置（可选）──
# 监听地址（默认 127.0.0.1，如需外部访问设为 0.0.0.0）
# HOST=127.0.0.1

# 监听端口（默认 8777）
# PORT=8777

# ── 测试脚本专用（仅运行 test_v062.py / test_10rounds.py 时需要）──
# TEST_BASE_URL=http://localhost:8777
# TEST_WS_URL=ws://localhost:8777/ws
# TEST_USERNAME=admin
# TEST_PASSWORD=your_test_password
# TEST_API_KEY=sk-your-api-key
# TEST_MODEL_SMALL=deepseek-v4-flash
# TEST_MODEL_LARGE=deepseek-v4-flash
# TEST_TOKEN=your_jwt_token    # test_10rounds.py 使用token替代用户名密码
