        {"type": "ending_card", "params": {"title": "镜碎人安", "desc": "你销毁了所有的镜面。院长的怨念失去了锚点，消散在黑暗之中。血月褪去，窗外第一缕晨光照在你的手上——满是伤痕，但活着。", "icon": "🌅"}},
        {"type": "ach_custom", "params": {"name": "镜碎人安", "icon": "🌅", "scenario_name": "血月医院", "desc": "达成真结局：销毁所有镜面"}}
